{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "en-card",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/images/*", "/original/*"],
  },
  "vars": {
    "APP_ORIGIN": "https://en-card.YOUR-SUBDOMAIN.workers.dev",
    "COST_MODE": "free_only",
    "SEND_MODE": "dry_run",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "en-card",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "kv_namespaces": [{ "binding": "CARD_IMAGES", "id": "00000000000000000000000000000000" }],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": false },
}

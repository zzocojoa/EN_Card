{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "en-card-png-feasibility",
  "main": "atlas-blit-worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "define": { "BLIT_MODE": "\"native\"" },
  "rules": [
    { "type": "Data", "globs": ["**/common.bin"], "fallthrough": false },
    { "type": "Text", "globs": ["**/metrics.data"], "fallthrough": false },
  ],
  "assets": {
    "directory": "../../.automation-png/atlas-optimized/assets",
    "binding": "ATLAS_ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "observability": { "enabled": false },
}

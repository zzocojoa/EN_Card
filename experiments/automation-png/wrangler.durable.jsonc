{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "en-card-png-do-trial",
  "main": "durable-worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../.automation-png/durable/assets",
    "binding": "FONT_ASSETS",
    "run_worker_first": true,
  },
  "durable_objects": { "bindings": [{ "name": "PNG_TRIAL", "class_name": "CardPngTrial" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CardPngTrial"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "en-card-png-do-trial",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations",
    },
  ],
  "kv_namespaces": [{ "binding": "CARD_IMAGES", "id": "00000000000000000000000000000000" }],
  "observability": { "enabled": false },
}

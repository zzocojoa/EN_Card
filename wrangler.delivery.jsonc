{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "en-card-delivery",
  "main": "src/worker/delivery-service.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ORIGIN": "https://en-card.YOUR-SUBDOMAIN.workers.dev",
    "COST_MODE": "free_only",
    "SEND_MODE": "live",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "en-card",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "observability": { "enabled": false },
}
